# ==============================================================================
# Gemini Enterprise SharePoint MCP Integration - Environment Configuration
# ==============================================================================

# --- Google Cloud Project Configuration ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
ENABLE_DLP=false

# --- Microsoft Entra ID (Azure AD) Credentials ---
# Required for LIVE mode. If omitted or MOCK_MODE=true, server operates in local sandbox mode.
MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_ID=11111111-1111-1111-1111-111111111111
MS_GRAPH_CLIENT_SECRET=your_entra_id_client_secret_here

# --- SharePoint & Microsoft 365 Tenant ---
SHAREPOINT_INSTANCE_URL=https://yourcompany.sharepoint.com

# --- Governance & Operational Safety Switches ---
# Set MOCK_MODE=true to run offline without an active M365 tenant (loads mock fixtures)
MOCK_MODE=false

# Set READ_ONLY_MODE=true to block upload, update, folder creation, and deletion tools
READ_ONLY_MODE=false

# Comma-separated list of Microsoft Purview sensitivity labels to block from text extraction
PURVIEW_BLOCKED_LABELS=Restricted,Do Not Export,Highly Confidential

# Character window limit per extracted document (default 50,000 characters)
MAX_EXTRACTED_CHARS=50000

# Server Port
PORT=3000
